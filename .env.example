# =============================================================================
# A Curious Thing - environment configuration
# Copy to .env  (cp .env.example .env)  and fill in what you need.
# .env is git-ignored. NEVER commit real credentials.
#
# Everything here is optional for a dry run:
#   python -m src.main run --dry-run
# works with no keys at all (it uses keyless public archives and a local
# deterministic "stub" writer). Keys are what make it good, and what let it send.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LLM  (used for triage, research synthesis, writing and quality control)
# -----------------------------------------------------------------------------
# Provider: anthropic | openai | stub
#   stub   = no network, deterministic placeholder prose. Useful for tests/CI.
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional overrides; sensible defaults live in config/config.yaml
# LLM_MODEL=claude-sonnet-5
# LLM_TRIAGE_MODEL=claude-haiku-4-5-20251001
# LLM_BASE_URL=

# -----------------------------------------------------------------------------
# 2. Email delivery
# -----------------------------------------------------------------------------
# Provider: smtp | resend | sendgrid | console | file
#   smtp    = recommended default for a personal newsletter (Gmail app password)
#   console = print to stdout, file = write .eml to output/ (both send nothing)
EMAIL_PROVIDER=smtp
EMAIL_FROM="A Curious Thing <you@example.com>"
# Optional: defaults to the address in EMAIL_FROM, which is usually what you
# want for a newsletter you are writing to yourself.
EMAIL_TO=you@example.com
# Optional: reply-to shown to the reader
# EMAIL_REPLY_TO=you@example.com

# --- SMTP (Gmail, Fastmail, Migadu, your own server, ...) --------------------
# These four are often misread, so, plainly:
#
#   SMTP_HOST      the mail SERVER's address. Not an email address.
#                  Gmail: smtp.gmail.com   Outlook: smtp-mail.outlook.com
#   SMTP_PORT      587 for STARTTLS (usual), 465 for SSL
#   SMTP_USERNAME  this one IS your email address
#   SMTP_PASSWORD  NOT your account password. Gmail and most providers reject
#                  those over SMTP. Create an app-specific password:
#                  https://myaccount.google.com/apppasswords
#                  (requires two-factor authentication on the account first)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls | ssl | none
SMTP_SECURITY=starttls

# --- Resend (https://resend.com) ---------------------------------------------
# RESEND_API_KEY=

# --- SendGrid (https://sendgrid.com) -----------------------------------------
# SENDGRID_API_KEY=

# -----------------------------------------------------------------------------
# 3. Schedule  (also configurable in config/config.yaml; env wins)
# -----------------------------------------------------------------------------
# TIMEZONE is IANA format, e.g. Asia/Kolkata, Europe/London, America/New_York.
TIMEZONE=Asia/Kolkata
SEND_INTERVAL_DAYS=2
SEND_HOUR=8
SEND_MINUTE=0

# -----------------------------------------------------------------------------
# 4. Optional discovery-source API keys
#    Every source that needs a key is simply skipped when the key is absent.
# -----------------------------------------------------------------------------
# NASA: DEMO_KEY works but is heavily rate-limited. Free key: https://api.nasa.gov
NASA_API_KEY=DEMO_KEY
# Smithsonian Open Access: https://api.data.gov/signup/
SMITHSONIAN_API_KEY=
# Europeana: https://pro.europeana.eu/pages/get-api
EUROPEANA_API_KEY=

# -----------------------------------------------------------------------------
# 5. Runtime
# -----------------------------------------------------------------------------
# Database location. On GitHub Actions this file is committed back to the repo.
DATABASE_PATH=data/curious.db
# Where rendered editions and run artefacts are written.
OUTPUT_DIR=output
# text | json   (json is what you want in CI)
LOG_FORMAT=text
LOG_LEVEL=INFO
# A polite, identifying User-Agent is required by Wikimedia and appreciated
# by every other archive. Put a real contact address in it.
HTTP_USER_AGENT=CuriousThings/1.0 (personal newsletter; contact: you@example.com)
