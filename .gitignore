# Runtime artifacts
output/
logs/
data/cache/

# The edition history IS committed - that is how state survives GitHub Actions'
# ephemeral filesystem (see README, "Database and state"). Only SQLite's
# transient sidecar files are ignored; Database.close() checkpoints the WAL so
# the .db file alone is complete and consistent.
data/*.db-wal
data/*.db-shm
data/*.db-journal

# OS / editors
.DS_Store
.idea/
.vscode/
